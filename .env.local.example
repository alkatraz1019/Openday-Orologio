# Copia questo file in ".env.local" per lo sviluppo locale.
# Su Vercel imposta le stesse 4 variabili in: Project → Settings → Environment Variables

# Da Supabase → Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co

# Da Supabase → Settings → API → "anon public" (sicura da esporre nel browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Da Supabase → Settings → API → "service_role" (SOLO lato server, mai nel browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# La password dell'area /admin — scegline una tua
ADMIN_PASSWORD=cambia-questa-password
